+def _load_exact_quantizer():
+    global _exact_quantizer
+    if _exact_quantizer is not None:
+        return _exact_quantizer
+    spec = importlib.util.spec_from_file_location(
+        "h3_exact_rowwise_int8", _exact_quantizer_so
+    )
