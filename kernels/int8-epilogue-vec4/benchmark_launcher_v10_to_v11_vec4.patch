+def _load_vec4_epilogue():
+    """Load the required candidate DSO; never silently benchmark without it."""
+    global _vec4_epilogue
+    if _vec4_epilogue is not None:
+        return _vec4_epilogue
+    spec = importlib.util.spec_from_file_location(
+        "h3_exact_epilogue_vec4", _vec4_epilogue_so
+    )
+    if spec is None or spec.loader is None:
+        raise RuntimeError(
+            f"Cannot load required H3 exact vec4 epilogue from {_vec4_epilogue_so}"
+        )
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    if not hasattr(module, "epilogue"):
+        raise RuntimeError(
+            "H3 exact vec4 epilogue DSO lacks epilogue: "
+            f"{_vec4_epilogue_so}"
+        )
+    _vec4_epilogue = module
     return module
