+def _vec4_epilogue_gate(
+    accumulator: torch.Tensor,
+    row_scale: torch.Tensor,
+    col_scale: torch.Tensor,
+    bias: torch.Tensor | None,
+    out_dtype: torch.dtype,
+) -> tuple[bool, str]:
+    if not _vec4_epilogue_enabled:
+        return False, "disabled"
+    if bias is not None:
+        return False, "bias"
+    if out_dtype != torch.bfloat16:
+        return False, "out_dtype"
+    if accumulator.dtype != torch.int32:
+        return False, "acc_dtype"
+    if row_scale.dtype != torch.float32:
+        return False, "row_scale_dtype"
+    if col_scale.dtype != torch.float32:
+        return False, "col_scale_dtype"
+    if not accumulator.is_cuda or not row_scale.is_cuda or not col_scale.is_cuda:
+        return False, "device"
+    if not (
+        accumulator.device == row_scale.device == col_scale.device
+    ):
+        return False, "device_mismatch"
+    if not accumulator.is_contiguous():
+        return False, "acc_noncontiguous"
+    if not row_scale.is_contiguous():
+        return False, "row_scale_noncontiguous"
+    if not col_scale.is_contiguous():
+        return False, "col_scale_noncontiguous"
+    if accumulator.dim() != 2 or accumulator.shape[0] != _VEC4_EPILOGUE_M:
+        return False, "M"
+    if accumulator.shape[1] not in _VEC4_EPILOGUE_N:
+        return False, "N"
+    if row_scale.dim() != 1 or row_scale.numel() != accumulator.shape[0]:
+        return False, "row_scale_shape"
+    if col_scale.dim() != 1 or col_scale.numel() != accumulator.shape[1]:
+        return False, "col_scale_shape"
+    if not _is_gfx936(accumulator):
+        return False, "arch"
+    return True, "eligible"
 
 
+def _record_vec4_fallback(
+    reason: str,
+    accumulator: torch.Tensor,
+    bias: torch.Tensor | None,
+    out_dtype: torch.dtype,
+) -> None:
+    _vec4_epilogue_fallbacks[reason] += 1
+    if _vec4_epilogue_fallbacks[reason] == 1:
+        logging.warning(
+            "H3 exact vec4 epilogue fallback reason=%s shape=%s dtype=%s "
+            "contiguous=%s bias=%s out_dtype=%s",
+            reason,
+            tuple(accumulator.shape),
+            accumulator.dtype,
+            accumulator.is_contiguous(),
+            bias is not None,
+            out_dtype,
+        )
+
+
+def _log_vec4_epilogue_counts():
+    logging.warning(
+        "H3 exact vec4 epilogue final hits=%d fallbacks=%d reasons=%s",
+        _vec4_epilogue_hits,
+        sum(_vec4_epilogue_fallbacks.values()),
+        dict(sorted(_vec4_epilogue_fallbacks.items())),
+    )
+
+
